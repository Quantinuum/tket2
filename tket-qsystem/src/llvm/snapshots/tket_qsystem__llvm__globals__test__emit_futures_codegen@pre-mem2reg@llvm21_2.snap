; ModuleID = 'test_context'
source_filename = "test_context"

@__globals__.my_global = global { i1, i16 } { i1 false, i16 poison }

define internal { i16, i1 } @_hl.main.1(i16 %0, ptr %1, i1 %2) {
alloca_block:
  %"0" = alloca i16, align 2
  %"1" = alloca i1, align 1
  %"2_0" = alloca i16, align 2
  %"2_1" = alloca ptr, align 8
  %"2_2" = alloca i1, align 1
  %"4_0" = alloca i16, align 2
  %"4_1" = alloca i1, align 1
  br label %entry_block

entry_block:                                      ; preds = %alloca_block
  store i16 %0, ptr %"2_0", align 2
  store ptr %1, ptr %"2_1", align 8
  store i1 %2, ptr %"2_2", align 1
  %"2_01" = load i16, ptr %"2_0", align 2
  %"2_12" = load ptr, ptr %"2_1", align 8
  %"2_23" = load i1, ptr %"2_2", align 1
  %start_value = load { i1, i16 }, ptr @__globals__.my_global, align 2
  %3 = insertvalue { i1, i16 } { i1 true, i16 poison }, i16 %"2_01", 1
  store { i1, i16 } %3, ptr @__globals__.my_global, align 2
  %call_func = call i1 %"2_12"(i1 %"2_23")
  %end_value = load { i1, i16 }, ptr @__globals__.my_global, align 2
  %4 = extractvalue { i1, i16 } %end_value, 1
  store { i1, i16 } %start_value, ptr @__globals__.my_global, align 2
  store i16 %4, ptr %"4_0", align 2
  store i1 %call_func, ptr %"4_1", align 1
  %"4_04" = load i16, ptr %"4_0", align 2
  %"4_15" = load i1, ptr %"4_1", align 1
  store i16 %"4_04", ptr %"0", align 2
  store i1 %"4_15", ptr %"1", align 1
  %"06" = load i16, ptr %"0", align 2
  %"17" = load i1, ptr %"1", align 1
  %mrv = insertvalue { i16, i1 } poison, i16 %"06", 0
  %mrv8 = insertvalue { i16, i1 } %mrv, i1 %"17", 1
  ret { i16, i1 } %mrv8
}
